// MalaiseItem.Tooltip: ""
RallyItem.Tooltip: Наносит на {0}% больше урона в бою с одним противником

SoulTormentorItem: {
	DisplayName: Истязатель душ
	Tooltip:
		'''
		Очаровывает {0} ближайших противников
		Попадание по очарованному противнику наносит урон остальным
		«Нет, это не любовный треугольник...»
		'''
}

StrangeDrinkItem: {
	DisplayName: Странный напиток
	Tooltip:
		'''
		Может заинтересовать медсестру
		«Даже не думай выпить это!»
		'''
}

