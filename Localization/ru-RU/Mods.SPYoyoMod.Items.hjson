AmazonItem.Tooltip:
	'''
	Есть шанс прикрепить врага к земле
	Попадание по закрепленному врагу выпускает бритвенно-острые листья
	'''
// ArteryItem.Tooltip: ""

BearingItem: {
	DisplayName: Подшипник
	Tooltip: Увеличивает время полета йо-йо на {0}%
}

BellowingThunderItem: {
	DisplayName: Раскаты грома
	Tooltip:
		'''
		Критические удары раскрывают истинную силу йо-йо
		Во время грозы шанс критического удара увеличен на {0}%
		'''
}

BlackholeItem: {
	DisplayName: Черная дыра
	// Tooltip: ""
}

BowOfDivinePriestessItem: {
	DisplayName: Бант божественной жрицы
	Tooltip: Дает возможность ходить по воде
}

CascadeItem.Tooltip:
	'''
	Есть шанс при попадании наложить дебафф «{$BuffName.OnFire}»
	Периодически взрывается, нанося урон по области
	'''
